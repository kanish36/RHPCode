import java.util.*;

public class Main {

    static int n;
    static int[][] grid;

    static int[] dr = {1, -1, 0, 0};
    static int[] dc = {0, 0, 1, -1};

    static int dfs(int r, int c, int id) {

        if (r < 0 || r >= n ||
            c < 0 || c >= n ||
            grid[r][c] != 1) {

            return 0;
        }

        grid[r][c] = id;

        int size = 1;

        for (int d = 0; d < 4; d++) {

            size += dfs(
                    r + dr[d],
                    c + dc[d],
                    id
            );
        }

        return size;
    }

    static int largestIsland(int[][] g) {

        grid = g;
        n = grid.length;

        Map<Integer, Integer> islandSize = new HashMap<>();

        int id = 2;

        // Give every island a unique ID
        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                if (grid[i][j] == 1) {

                    int size = dfs(i, j, id);

                    islandSize.put(id, size);

                    id++;
                }
            }
        }

        int answer = 0;

        // Check changing every 0 into 1
        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                if (grid[i][j] == 0) {

                    Set<Integer> seen = new HashSet<>();

                    int total = 1;

                    for (int d = 0; d < 4; d++) {

                        int r = i + dr[d];
                        int c = j + dc[d];

                        if (r >= 0 && r < n &&
                            c >= 0 && c < n &&
                            grid[r][c] > 1) {

                            int island = grid[r][c];

                            if (seen.add(island)) {
                                total += islandSize.get(island);
                            }
                        }
                    }

                    answer = Math.max(answer, total);
                }
            }
        }

        // If the grid contains no zero
        if (answer == 0) {
            return n * n;
        }

        return answer;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        n = sc.nextInt();

        grid = new int[n][n];

        for (int i = 0; i < n; i++) {

            for (int j = 0; j < n; j++) {

                grid[i][j] = sc.nextInt();
            }
        }

        System.out.println(largestIsland(grid));

        sc.close();
    }
}
