import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) throws Exception {

        BufferedReader br = new BufferedReader(
                new InputStreamReader(System.in)
        );

        int N = Integer.parseInt(br.readLine());

        StringTokenizer st = new StringTokenizer(br.readLine());

        // A[i] <= 200000
        int MAX = 200005;

        long[] diff = new long[MAX + 2];

        for (int i = 0; i < N; i++) {

            int A = Integer.parseInt(st.nextToken());

            // This repunit has 1 in positions 1 to A
            diff[1]++;
            diff[A + 1]--;
        }

        // Convert difference array to number of 1s
        long[] digit = new long[MAX + 2];

        long current = 0;

        int last = 0;

        for (int i = 1; i <= MAX; i++) {

            current += diff[i];

            digit[i] = current;

            if (digit[i] > 0) {
                last = i;
            }
        }

        // Handle carrying
        for (int i = 1; i <= last; i++) {

            digit[i + 1] += digit[i] / 10;

            digit[i] %= 10;

            if (digit[i + 1] > 0) {
                last = Math.max(last, i + 1);
            }
        }

        // Print from most significant digit
        StringBuilder answer = new StringBuilder();

        for (int i = last; i >= 1; i--) {
            answer.append(digit[i]);
        }

        System.out.println(answer);
    }
}
