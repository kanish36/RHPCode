import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] last = new int[n + 1];

        Arrays.fill(last, -1);

        long answer = 0;

        for (int i = 0; i < n; i++) {

            int x = sc.nextInt();

            /*
             * Number of subarrays ending at i
             * where x appears for the first time.
             */
            answer += (long) (i - last[x]) * (last[x] + 1);

            last[x] = i;
        }

        /*
         * Count the contribution of the final occurrence
         * of every value.
         */
        for (int x = 1; x <= n; x++) {

            answer += (long) (n - last[x]) * (last[x] + 1);
        }

        System.out.println(answer);

        sc.close();
    }
}
