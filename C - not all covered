import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();
        int M = sc.nextInt();

        int[] diff = new int[N + 1];

        // Read all turrets
        for (int i = 0; i < M; i++) {

            int L = sc.nextInt();
            int R = sc.nextInt();

            // Difference array
            diff[L - 1]++;
            diff[R]--;
        }

        int current = 0;
        int answer = Integer.MAX_VALUE;

        // Prefix sum
        for (int i = 0; i < N; i++) {

            current += diff[i];

            answer = Math.min(answer, current);
        }

        System.out.println(answer);

        sc.close();
    }
}
